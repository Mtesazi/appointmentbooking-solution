# Local Docker Compose settings only. Replace these values before use.
POSTGRES_USER=dev-user
POSTGRES_PASSWORD=change-this-local-db-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# These alternate host ports avoid colliding with local services.
POSTGRES_PORT=5433
MAILPIT_SMTP_PORT=1026
MAILPIT_WEB_PORT=8026
